# ========================================================
# Local MCP Server Environment Configuration
# ========================================================

# Host and port for the local Uvicorn server
HOST=127.0.0.1
PORT=8000

# Public Cloudflare Tunnel URL (used by start_server.bat and verify_server.py)
# Example: https://mcp.yourdomain.com/mcp or https://<tunnel-id>.cfargotunnel.com/mcp
CLOUDFLARE_TUNNEL_URL=

# (Optional) If you want start_server.bat to automatically boot cloudflared.exe
# when it is not already running, specify either your tunnel name or token:
# CLOUDFLARE_TUNNEL_NAME=my-named-tunnel
# or
# CLOUDFLARE_TUNNEL_TOKEN=eyJh...
